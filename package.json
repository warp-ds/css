{
  "name": "@warp-ds/css",
  "repository": "git@github.com:warp-ds/css.git",
  "version": "2.5.0-next.2",
  "packageManager": "pnpm@11.13.1",
  "peerDependencies": {
    "@warp-ds/uno": "2.x"
  },
  "scripts": {
    "build": "pnpm build:tokens && pnpm build:resets && pnpm build:cc && pnpm lint:fix",
    "commit": "cz",
    "semantic-release": "semantic-release",
    "build:cc": "cd component-classes && rm -rf *.d.ts && tsc && vite build",
    "build:tokens": "node index.js",
    "build:resets": "cd resets && node index.js",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "test": "node tests/no-dropped-components-classes.js"
  },
  "type": "module",
  "exports": {
    "./component-classes": "./component-classes/index.js",
    "./components": "./dist/components.css",
    "./component-classes/classes": "./component-classes/classes.js",
    "./component-classes/shortcuts": "./component-classes/shortcuts.js"
  },
  "typesVersions": {
    "*": {
      "./component-classes": [
        "./component-classes/index.d.ts"
      ],
      "./component-classes/classes": [
        "./component-classes/classes.d.ts"
      ],
      "./component-classes/shortcuts": [
        "./component-classes/shortcuts.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "./component-classes/index.js",
    "./component-classes/classes.js",
    "./component-classes/shortcuts.js",
    "./component-classes/index.d.ts"
  ],
  "devDependencies": {
    "@eik/cli": "3.1.63",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@sindresorhus/slugify": "3.0.0",
    "@warp-ds/eslint-config": "1.1.0",
    "@warp-ds/tokenizer": "0.0.4",
    "@warp-ds/uno": "2.x",
    "cz-conventional-changelog": "3.3.0",
    "drnm": "0.9.0",
    "eslint": "^10.5.0",
    "eslint-plugin-import": "2.32.0",
    "fs-extra": "11.3.6",
    "lightningcss": "1.32.0",
    "prettier": "3.9.5",
    "semantic-release": "25.0.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "unocss": "66.x",
    "unzipper": "0.12.5",
    "vite": "5.4.21",
    "vite-plugin-dts": "3.9.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "eik": {
    "server": "https://assets.finn.no",
    "files": "./dist"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "Apache-2.0"
}
